{
  "name": "atlas-web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "lint": "biome check . && node scripts/check-session-conventions.mjs && node scripts/check-data-conventions.mjs",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:session-matrix": "node scripts/run-session-matrix.mjs",
    "test:data-mutants": "node scripts/run-data-mutants.mjs",
    "test:engine-mutants": "node scripts/run-engine-mutants.mjs",
    "test:integration": "node scripts/integration/run.mjs --browsers chromium,firefox,webkit",
    "profile:session": "node scripts/profile-session.mjs",
    "profile:sync": "node scripts/profile-sync.mjs",
    "profile:contention": "node scripts/profile-contention.mjs",
    "test:e2e": "pnpm build && pnpm build:fixture && playwright test",
    "check:contract": "node scripts/check-contract.mjs",
    "build:fixture": "vite build --mode fixture",
    "preview:fixture": "vite preview --mode fixture --host 127.0.0.1",
    "package:prepare": "node scripts/write-provenance.mjs && node scripts/validate-provenance.mjs && node scripts/generate-notices.mjs",
    "package:archive": "node scripts/package-archive.mjs",
    "check:route-parity": "node scripts/check-route-parity.mjs",
    "check:artefacts": "node scripts/check-no-fixture.mjs dist && node scripts/check-external-urls.mjs dist && node scripts/check-budgets.mjs dist && node scripts/check-initial-chunk.mjs dist && node scripts/check-notices.mjs dist",
    "docs:tokens": "node scripts/generate-token-docs.mjs",
    "dev:fixture": "vite --mode fixture --host 127.0.0.1",
    "test:e2e:efficient": "pnpm build && pnpm build:fixture && node scripts/run-e2e-efficient.mjs",
    "test:validation-tools": "node --test scripts/validation/*.test.mjs"
  },
  "dependencies": {
    "@atlas/api-types": "file:vendor/atlas-api-types-0.28.0-rc.1.tgz",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.48.0",
    "openapi-fetch": "0.13.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest-axe": "3.5.9",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jest-axe": "11.0.0",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
