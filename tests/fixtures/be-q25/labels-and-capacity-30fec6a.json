  "schemas": {
    "ClientLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "browser", "platform"],
      "description": "Coarse description of the client that signed in, captured by the server when the session was issued (BE-Q25). channel comes from the route: browser for POST /browser-sessions/activate, native for POST /sessions, POST /registration and POST /oidc/native/exchange. browser and platform are derived only from that request's User-Agent header, which the client reports about itself and can change, so this is a hint for recognising a sign-in, never identity or proof of a device. Only these closed values are stored: no raw header, version, model, client hint or address. A header that is absent, repeated, over 512 bytes or not printable ASCII gives unknown and never blocks a sign-in. More values may be added in a MINOR version; treat an unrecognised value as unknown.",
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["browser", "native"]
        },
        "browser": {
          "type": ["string", "null"],
          "enum": [
            "chrome",
            "edge",
            "firefox",
            "safari",
            "opera",
            "samsung_internet",
            "unknown",
            null
          ],
          "description": "null exactly when channel is native."
        },
        "platform": {
          "type": "string",
          "enum": [
            "windows",
            "macos",
            "ios",
            "android",
            "linux",
            "chromeos",
            "unknown"
          ]
        }
      },
      "examples": [
        {
          "channel": "browser",
          "browser": "safari",
          "platform": "ios"
        },
        {
          "channel": "native",
          "browser": null,
          "platform": "android"
        }
      ]
    },
    "Capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "used", "remaining"],
      "description": "Used and remaining slots under one limit the server enforces, read from the same rows the enforcement counts at the time of this response (BE-Q25). Advisory, not a reservation: a concurrent sign-in or registration can take the last slot, and a slot is freed only when the sign-out, retirement or expiry that frees it commits.",
      "properties": {
        "limit": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "The configured limit, or null when the server does not enforce one."
        },
        "used": {
          "type": "integer",
          "minimum": 0
        },
        "remaining": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "max(limit - used, 0); null exactly when limit is null."
        }
      },
      "examples": [
        {
          "limit": 32,
          "used": 3,
          "remaining": 29
        }
      ]
    },
    "DeviceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "A name the account's owner chose for one of their devices (BE-Q25). 1 to 64 Unicode scalar values (at most 256 UTF-8 bytes), with no leading or trailing white space and no control, bidirectional-control (U+061C, U+200E, U+200F, U+202A-U+202E, U+2066-U+2069), invisible (U+200B, U+2060-U+2064, U+FEFF, U+FFF9-U+FFFB), line/paragraph-separator (U+2028, U+2029) or noncharacter code point. ZWJ and ZWNJ are allowed. Stored and returned exactly as accepted, without normalisation or trimming. It is user-supplied text: render it as text, never as markup."
    },
    "DeviceNameUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/components/schemas/DeviceName"
        }
      },
      "examples": [
        {
          "name": "Kieran's phone"
        }
      ]
    }
  },
