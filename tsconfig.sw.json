{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/sw.ts",
    "src/sw/**/*.ts",
    "src/lib/backend-routes.ts",
    "src/lib/pwa/protocol.ts"
  ]
}
