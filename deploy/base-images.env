# Base images used to build and test the atlas-web image and the reference proxy, pinned by digest.
# The digest is of the multi-architecture index (linux/amd64 2093..., linux/arm64 e00b...), resolved from the registry on
# 2026-09-28. Update by resolving a new index, running scripts/smoke-image.sh on both architectures, and recording the result.
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8
# PostgreSQL for the Compose example: the released backend container image refuses SQLite and requires PostgreSQL.
# Index digest of postgres:17.11 (the version the backend's own Compose file uses), resolved from the registry on 2026-09-28.
POSTGRES_IMAGE=postgres:17.11@sha256:d74eeac9a635390a49bc21bd49fccd973de707e2a53a76ac49b552b8712ec46f
