# Copy to deploy/.env and edit. Never commit the copy.

# The frontend image you built (docs/packaging.md) or pulled, and the Atlas backend image you have verified.
ATLAS_WEB_IMAGE=
ATLAS_BACKEND_IMAGE=

# The released backend container requires PostgreSQL. Use a long random URL-safe password (it is embedded in a URL).
ATLAS_POSTGRES_IMAGE=postgres:17.11@sha256:d74eeac9a635390a49bc21bd49fccd973de707e2a53a76ac49b552b8712ec46f
ATLAS_POSTGRES_PASSWORD=

# An unprivileged nginx image for the reference proxy, pinned by digest (deploy/base-images.env has the tested one).
ATLAS_PROXY_IMAGE=nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8

# The exact public origin: scheme, host and port as the browser sees them. It MUST equal the proxy's origin.
ATLAS_PUBLIC_ORIGIN=http://localhost:8090

ATLAS_LISTEN_ADDRESS=127.0.0.1
ATLAS_PROXY_PORT=8090
# The largest request body the proxy accepts. WEB-13 confirms the figure for 1 MiB calendar imports.
ATLAS_PROXY_MAX_BODY=8m
# Only if the backend must trust forwarded headers from the proxy: the proxy's exact IP address.
ATLAS_TRUSTED_PROXY_IPS=
