{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!vendor",
      "!dist",
      "!node_modules",
      "!playwright-report",
      "!test-results",
      "!dist-fixture",
      "!tests/.mutants",
      "!.agents",
      "!.agtx",
      "!.claude",
      "!.codex",
      "!.mcp.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/**",
        "!src/lib/api-client/boundary.ts",
        "!src/lib/api-client/unstamped.ts"
      ],
      "plugins": ["./lint/no-raw-network.grit"]
    },
    {
      "includes": ["src/**"],
      "plugins": ["./lint/no-locks-query.grit"]
    },
    {
      "includes": ["src/**", "!src/components/ui/**"],
      "plugins": ["./lint/portal-only-via-ui.grit"]
    },
    {
      "includes": [
        "src/**",
        "!src/session/**",
        "!src/fixture/**",
        "!src/protected-surface/**"
      ],
      "plugins": ["./lint/gate-import-allowlist.grit"]
    },
    {
      "includes": ["src/**", "!src/protected-surface/title.ts"],
      "plugins": ["./lint/title-only-via-module.grit"]
    },
    {
      "includes": [
        "src/**",
        "!src/components/ui/announcer.tsx",
        "!src/components/ui/neutral-gate.tsx",
        "!src/components/ui/neutral-state.tsx",
        "!src/components/ui/neutral-status.tsx",
        "!src/components/ui/sync-status.tsx"
      ],
      "plugins": ["./lint/live-region-registry.grit"]
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
